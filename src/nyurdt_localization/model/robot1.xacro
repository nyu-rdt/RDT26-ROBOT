<?xml version="1.0"?>
<robot name="test_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

<link name="base_link">

<visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
    <mesh filename="package://nyurdt_localization/model/robot.stl"
    scale="0.001 0.001 0.001"/>
    </geometry>
</visual>

<collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
    
    <box size="0.7 0.5 0.3"/>
    </geometry>
</collision>

<inertial>
    <origin xyz="0 0 0"/>
    <mass value="20"/>
    <inertia ixx="1" ixy="0" ixz="0"
    iyy="1" iyz="0"
    izz="1"/>
</inertial>

</link>

</robot>