<?xml version="1.0"?>
<!-- Author: Mandy Wang-->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
      
    <xacro:macro name="camera" params="parent pos size_x size_y size_z *origin">
    <!-- Pi constant -->
    <xacro:property name="pi_cam" value="3.14159265"/>

        <link name="${pos}_camera">
            <visual>
                <geometry>
                    <!-- logitech C615 -->
                    <box size="${size_x} ${size_y} ${size_z}"/>
                </geometry>
                <material name="black"> 
                    <color rgba="0 0 0 1"/>
                </material>    
            </visual>
        </link>

        <joint name="${pos}_camera_joint" type="fixed">
            <parent link="${parent}"/>
            <child link="${pos}_camera"/>
            <xacro:insert_block name="origin"/>
        </joint>
        <!--vision frame used by image and tf topics-->
        <link name="${pos}_camera_optical_frame_link"></link>

        <joint name="${pos}_camera_optical_frame_joint" type="fixed">
            <parent link="${pos}_camera"/>
            <child link="${pos}_camera_optical_frame_link"/>
            <origin xyz="0 0 0" rpy="${-pi_cam/2} 0 ${-pi_cam/2}"/>
        </joint>
    </xacro:macro>

</robot>