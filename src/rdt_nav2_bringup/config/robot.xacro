<?xml version="1.0"?>
<robot name="rdt26_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">


<xacro:property name="pi_const" value="3.14159265"/>

<xacro:property name="a" value="1" />
<xacro:property name="b" value="0.3" />
<xacro:property name="c" value="0.6" />

<xacro:property name="r" value="0.15" />
<xacro:property name="d" value="0.1" />

<xacro:property name="s1" value="${b/2+r}" />
<xacro:property name="s2" value="${2*r}" />
<xacro:property name="s3" value="${2*r}" />
<xacro:property name="s4" value="${c/2+d/2}" />


<xacro:property name="d1" value="2710.0" />
<xacro:property name="d2" value="2710.0" />


<xacro:property name="m1" value="${d1*a*b*c}" />
<xacro:property name="m2" value="${d2*pi_const*r*r*d}" />

<xacro:property name="Ix_body" value="${(1/12)*m1*(b*b+c*c)}" />
<xacro:property name="Iy_body" value="${(1/12)*m1*(a*a+b*b)}" />
<xacro:property name="Iz_body" value="${(1/12)*m1*(a*a+c*c)}" />

<xacro:property name="Iz_wheel" value="${0.5*m2*r*r}" />
<xacro:property name="I_wheel" value="${(1.0/12.0)*m2*(3.0*r*r+d*d)}" />


<xacro:macro name="inertia_body">
    <inertial>
    <origin rpy="0 0 0" xyz="0 0 ${s1}" />
    <mass value="${m1}" />
    <inertia ixx="${Ix_body}" ixy="0.0" ixz="0.0" iyy="${Iy_body}" iyz="0" izz="${Iz_body}" />
    </inertial>
</xacro:macro>

<xacro:macro name="inertia_wheel">
    <inertial>
    <origin rpy="1.570795 0 0" xyz="0 0 0" />
    <mass value="${m2}" />
    <inertia ixx="${I_wheel}" ixy="0.0" ixz="0.0" iyy="${I_wheel}" iyz="0" izz="${Iz_wheel}" />
    </inertial>
</xacro:macro>


<xacro:include filename="$(find rdt_nav2_bringup)/config/robot.gazebo" />
<xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro"/>


<link name="base_footprint"> </link>
<joint name="body_link_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="body_link"/>
</joint>

<link name="body_link">
    <visual>
        <geometry>
            <box size="${a} ${c} ${b}"/>
        </geometry>
    <origin rpy="0.0 0.0 0.0" xyz="0 0 ${s1}" />
    </visual>

    <collision>
        <geometry>
            <box size="${a} ${b} ${c}"/>
        </geometry>
        <origin rpy="0.0 0.0 0.0" xyz="0 0 ${s1}" />
    </collision>

    <xacro:inertia_body />
</link>

<joint name="wheel1_joint" type="continuous">
    <parent link="body_link"/>
    <child link="wheel1_link"/>
    <origin xyz="${-s2} ${-s4} ${r}" rpy="0.0 0.0 0.0" />
    <axis xyz="0.0 1.0 0.0"/>
    <limit effort="50000" velocity="10"/>
    <dynamics damping="1.0" friction="1.0"/>
 </joint>

 <link name="wheel1_link">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="1.570795 0.0 0.0"/>
        <geometry>
            <cylinder radius="${r}" length="${d}"/>
        </geometry>
    </visual>

    <collision>
        <origin xyz="0.0 0.0 0.0" rpy="1.570795 0.0 0.0"/>
        <geometry>
            <cylinder radius="${r}" length="${d}"/>
        </geometry>
    </collision>
    <xacro:inertia_wheel />
</link>

<joint name="wheel2_joint" type="continuous">
    <parent link="body_link"/>
    <child link="wheel2_link"/>
    <origin xyz="${-s2} ${s4} ${r}" rpy="0.0 0.0 0.0" />
    <axis xyz="0.0 1.0 0.0"/>
    <limit effort="50000" velocity="10"/>
    <dynamics damping="1.0" friction="1.0"/>
 </joint>

 <link name="wheel2_link">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="1.570795 0.0 0.0"/>
        <geometry>
            <cylinder radius="${r}" length="${d}"/>
        </geometry>
    </visual>

    <collision>
        <origin xyz="0.0 0.0 0.0" rpy="1.570795 0.0 0.0"/>
        <geometry>
            <cylinder radius="${r}" length="${d}"/>
        </geometry>
    </collision>
    <xacro:inertia_wheel />
</link>


<joint name="wheel3_joint" type="continuous">
    <parent link="body_link"/>
    <child link="wheel3_link"/>
    <origin xyz="${s3} ${s4} ${r}" rpy="0.0 0.0 0.0" />
    <axis xyz="0.0 1.0 0.0"/>
    <limit effort="50000" velocity="10"/>
    <dynamics damping="1.0" friction="1.0"/>
 </joint>

 <link name="wheel3_link">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="1.570795 0.0 0.0"/>
        <geometry>
            <cylinder radius="${r}" length="${d}"/>
        </geometry>
    </visual>

    <collision>
        <origin xyz="0.0 0.0 0.0" rpy="1.570795 0.0 0.0"/>
        <geometry>
            <cylinder radius="${r}" length="${d}"/>
        </geometry>
    </collision>
    <xacro:inertia_wheel />
</link>

<joint name="wheel4_joint" type="continuous">
    <parent link="body_link"/>
    <child link="wheel4_link"/>
    <origin xyz="${s3} ${-s4} ${r}" rpy="0.0 0.0 0.0" />
    <axis xyz="0.0 1.0 0.0"/>
    <limit effort="50000" velocity="10"/>
    <dynamics damping="1.0" friction="1.0"/>
 </joint>

 <link name="wheel4_link">
    <visual>
        <origin xyz="0.0 0.0 0.0" rpy="1.570795 0.0 0.0"/>
        <geometry>
            <cylinder radius="${r}" length="${d}"/>
        </geometry>
    </visual>

    <collision>
        <origin xyz="0.0 0.0 0.0" rpy="1.570795 0.0 0.0"/>
        <geometry>
            <cylinder radius="${r}" length="${d}"/>
        </geometry>
    </collision>
    <xacro:inertia_wheel />
</link>
<xacro:sensor_d435 parent="body_link" name="camera" use_nominal_extrinsics="true">
    <origin xyz="0.5 0 0.3" rpy="0 0 0"/>
</xacro:sensor_d435>
<gazebo reference="camera_link">
  <sensor name="realsense_d435" type="rgbd_camera">
    <topic>realsense</topic> <camera>
      <horizontal_fov>1.047</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.1</near>
        <far>100</far>
      </clip>
      <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
      </noise>
    </camera>
    <always_on>1</always_on>
    <update_rate>30</update_rate>
    <visualize>true</visualize>
  </sensor>
</gazebo>

<link name="laser_frame">
    <visual>
        <geometry>
            <cylinder radius="0.05" length="0.04"/>
        </geometry>
        <material name="black">
            <color rgba="0 0 0 1"/>
        </material>
    </visual>
    <collision>
        <geometry>
            <cylinder radius="0.05" length="0.04"/>
        </geometry>
    </collision>
    <inertial>
        <mass value="0.1" />
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
    </inertial>
</link>

<joint name="laser_joint" type="fixed">
    <parent link="body_link"/>
    <child link="laser_frame"/>
    <origin xyz="0.4 0 ${s1 + 0.15}" rpy="0 0 0"/>
</joint>

<gazebo reference="laser_frame"> <sensor name="laser_sensor" type="gpu_lidar">
    <gz_frame_id>laser_frame</gz_frame_id> <topic>/scan</topic>
    <update_rate>10</update_rate>
    <ray>
      <scan>
        <horizontal>
          <samples>360</samples>
          <resolution>1</resolution>
          <min_angle>-3.14</min_angle>
          <max_angle>3.14</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.1</min>
        <max>12.0</max>
      </range>
    </ray>
    <visualize>true</visualize>
  </sensor>
</gazebo>


</robot>