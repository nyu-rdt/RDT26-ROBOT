<?xml version="1.0"?>
<!-- Author: Mandy Wang-->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
      
    <xacro:macro name="camera" params="parent pos size_x size_y size_z *origin">
    <!-- Pi constant -->
    <xacro:property name="pi_cam" value="3.14159265"/>

        <link name="${pos}_camera">
            <visual>
                <geometry>
                    <box size="${size_x} ${size_y} ${size_z}"/>
                </geometry>
                <material name="black"> 
                    <color rgba="0 0 0 1"/>
                </material>    
            </visual>
        </link>

        <joint name="${pos}_camera_joint" type="fixed">
            <parent link="${parent}"/>
            <child link="${pos}_camera"/>
            <xacro:insert_block name="origin"/>
        </joint>
        <!--vision frame used by image and tf topics-->
        <link name="${pos}_camera_optical_frame_link"></link>

        <joint name="${pos}_camera_optical_frame_joint" type="fixed">
            <parent link="${pos}_camera"/>
            <child link="${pos}_camera_optical_frame_link"/>
            <origin xyz="0 0 0" rpy="${-pi_cam/2} 0 ${-pi_cam/2}"/>
        </joint>

        <!-- Simulated camera using rgbd_camera (works with ogre render engine).
             body_link is transparent in robot.gazebo so cameras inside the robot
             body can see through it and render images correctly. -->
        <gazebo reference="${pos}_camera">
            <sensor name="${pos}_cam" type="rgbd_camera">
                <topic>${pos}_cam</topic>
                <camera>
                    <horizontal_fov>1.047</horizontal_fov>
                    <image>
                        <width>320</width>
                        <height>240</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.1</near>
                        <far>8.0</far>
                    </clip>
                    <depth_camera>
                        <output>depths</output>
                        <clip>
                            <near>0.1</near>
                            <far>8.0</far>
                        </clip>
                    </depth_camera>
                </camera>
                <always_on>1</always_on>
                <update_rate>5</update_rate>
                <visualize>false</visualize>
            </sensor>
        </gazebo>
    </xacro:macro>

</robot>