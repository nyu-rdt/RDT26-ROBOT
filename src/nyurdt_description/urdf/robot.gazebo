<?xml version="1.0"?>
<robot>

<gazebo reference="body_link">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <material>Gazebo/Red</material>
    <!-- Cameras inside the body see through it via sensor near-clip (0.1 m):
         back wall is 0.09 m from back_cam origin → within clip distance → invisible to sensor. -->
</gazebo>

<gazebo reference="wheel1_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/White</material>
</gazebo>

<gazebo reference="wheel2_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/White</material>
</gazebo>

<gazebo reference="wheel3_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/White</material>
</gazebo>

<gazebo reference="wheel4_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/White</material>
</gazebo>

<gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">

        <!-- wheels — front pair and back pair -->
        <left_joint>wheel2_joint</left_joint>   <!-- back left  -->
        <left_joint>wheel3_joint</left_joint>   <!-- front left -->
        <right_joint>wheel1_joint</right_joint> <!-- back right -->
        <right_joint>wheel4_joint</right_joint> <!-- front right-->

        <!-- kinematics — s3 = b/2 + d/2, so separation = 2*s3 -->
        <wheel_separation>${2*s3}</wheel_separation>
        <wheel_diameter>${2*r}</wheel_diameter>

        <!-- limits -->
        <max_linear_acceleration>10</max_linear_acceleration>

        <!-- topics and frames -->
        <topic>cmd_vel</topic>
        <tf_topic>tf</tf_topic>
        <odom_topic>odom</odom_topic>
        <frame_id>odom</frame_id>
        <publish_odom_tf>true</publish_odom_tf>
        <child_frame_id>base_link</child_frame_id>  <!-- changed from base_footprint -->
        <odom_publisher_frequency>30</odom_publisher_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>joint_states</topic>
        <joint_name>wheel1_joint</joint_name>
        <joint_name>wheel2_joint</joint_name>
        <joint_name>wheel3_joint</joint_name>
        <joint_name>wheel4_joint</joint_name>
    </plugin>
</gazebo>

</robot>