<?xml version="1.0"?>
<robot name="rdt26_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:property name="pi_const" value="3.14159265"/>

<!-- Real robot dimensions (metres) -->
<xacro:property name="a" value="0.745" />   <!-- length -->
<xacro:property name="b" value="0.608" />   <!-- width  -->
<xacro:property name="c" value="0.660" />   <!-- height -->

<!-- Wheel dimensions — measure and confirm these -->
<xacro:property name="r" value="0.17" />    <!-- wheel radius -->
<xacro:property name="d" value="0.1"  />    <!-- wheel width  -->

<xacro:property name="s1" value="${c/2}"         />   <!-- body centre height -->
<xacro:property name="s2" value="${a/2}"         />   <!-- wheel x offset (front/back) -->
<xacro:property name="s3" value="${b/2 + d/2}"   />   <!-- wheel y offset (left/right) -->

<!-- Material density -->
<xacro:property name="d1" value="2710.0" />
<xacro:property name="d2" value="2710.0" />

<!-- Mass -->
<xacro:property name="m1" value="${d1*a*b*c}" />
<xacro:property name="m2" value="${d2*pi_const*r*r*d}" />

<!-- Inertia body -->
<xacro:property name="Ix_body" value="${(1/12)*m1*(b*b+c*c)}" />
<xacro:property name="Iy_body" value="${(1/12)*m1*(a*a+b*b)}" />
<xacro:property name="Iz_body" value="${(1/12)*m1*(a*a+c*c)}" />

<!-- Inertia wheel -->
<xacro:property name="Iz_wheel" value="${0.5*m2*r*r}" />
<xacro:property name="I_wheel"  value="${(1.0/12.0)*m2*(3.0*r*r+d*d)}" />

<xacro:macro name="inertia_body">
    <inertial>
        <origin rpy="0 0 0" xyz="0 0 ${s1}"/>
        <mass value="${m1}"/>
        <inertia ixx="${Ix_body}" ixy="0" ixz="0"
                                  iyy="${Iy_body}" iyz="0"
                                                    izz="${Iz_body}"/>
    </inertial>
</xacro:macro>

<xacro:macro name="inertia_wheel">
    <inertial>
        <origin rpy="1.570795 0 0" xyz="0 0 0"/>
        <mass value="${m2}"/>
        <inertia ixx="${I_wheel}" ixy="0" ixz="0"
                                  iyy="${I_wheel}" iyz="0"
                                                    izz="${Iz_wheel}"/>
    </inertial>
</xacro:macro>

<xacro:include filename="$(find nyurdt_description)/urdf/robot.gazebo"/>
<xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro"/>

<!-- ── Frames ─────────────────────────────────────────────────────────── -->

<!-- base_link: Nav2 + RTAB-Map reference frame, at ground centre -->
<link name="base_link"/>

<joint name="body_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="body_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
</joint>

<link name="body_link">
    <visual>
        <geometry>
            <box size="${a} ${b} ${c}"/>
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 ${s1}"/>
    </visual>
    <collision>
        <geometry>
            <box size="${a} ${b} ${c}"/>
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 ${s1}"/>
    </collision>
    <xacro:inertia_body/>
</link>

<!-- ── Wheels ─────────────────────────────────────────────────────────── -->

<!-- Back right -->
<joint name="wheel1_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel1_link"/>
    <origin xyz="${-s2} ${-s3} ${r}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="50000" velocity="10"/>
    <dynamics damping="1.0" friction="1.0"/>
</joint>
<link name="wheel1_link">
    <visual>
        <origin xyz="0 0 0" rpy="1.570795 0 0"/>
        <geometry><cylinder radius="${r}" length="${d}"/></geometry>
    </visual>
    <collision>
        <origin xyz="0 0 0" rpy="1.570795 0 0"/>
        <geometry><cylinder radius="${r}" length="${d}"/></geometry>
    </collision>
    <xacro:inertia_wheel/>
</link>

<!-- Back left -->
<joint name="wheel2_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel2_link"/>
    <origin xyz="${-s2} ${s3} ${r}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="50000" velocity="10"/>
    <dynamics damping="1.0" friction="1.0"/>
</joint>
<link name="wheel2_link">
    <visual>
        <origin xyz="0 0 0" rpy="1.570795 0 0"/>
        <geometry><cylinder radius="${r}" length="${d}"/></geometry>
    </visual>
    <collision>
        <origin xyz="0 0 0" rpy="1.570795 0 0"/>
        <geometry><cylinder radius="${r}" length="${d}"/></geometry>
    </collision>
    <xacro:inertia_wheel/>
</link>

<!-- Front left -->
<joint name="wheel3_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel3_link"/>
    <origin xyz="${s2} ${s3} ${r}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="50000" velocity="10"/>
    <dynamics damping="1.0" friction="1.0"/>
</joint>
<link name="wheel3_link">
    <visual>
        <origin xyz="0 0 0" rpy="1.570795 0 0"/>
        <geometry><cylinder radius="${r}" length="${d}"/></geometry>
    </visual>
    <collision>
        <origin xyz="0 0 0" rpy="1.570795 0 0"/>
        <geometry><cylinder radius="${r}" length="${d}"/></geometry>
    </collision>
    <xacro:inertia_wheel/>
</link>

<!-- Front right -->
<joint name="wheel4_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel4_link"/>
    <origin xyz="${s2} ${-s3} ${r}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="50000" velocity="10"/>
    <dynamics damping="1.0" friction="1.0"/>
</joint>
<link name="wheel4_link">
    <visual>
        <origin xyz="0 0 0" rpy="1.570795 0 0"/>
        <geometry><cylinder radius="${r}" length="${d}"/></geometry>
    </visual>
    <collision>
        <origin xyz="0 0 0" rpy="1.570795 0 0"/>
        <geometry><cylinder radius="${r}" length="${d}"/></geometry>
    </collision>
    <xacro:inertia_wheel/>
</link>

<!-- ── RealSense D435 ──────────────────────────────────────────────────── -->
<!-- mounted at front face centre, ~33cm off ground -->
<xacro:sensor_d435 parent="base_link" name="camera" use_nominal_extrinsics="true">
    <origin xyz="0.37 0.0 0.69" rpy="0 0.767945 0"/>
</xacro:sensor_d435>

<gazebo reference="camera_link">
    <!--
      Simulated RealSense D435 (rgbd_camera).
      Gazebo publishes on topic prefix "realsense":
        /realsense/image          → color image (bridged to /camera/camera/color/image_raw)
        /realsense/depth_image    → depth image (bridged to /camera/camera/depth/image_rect_raw)
        /realsense/camera_info    → camera info (bridged to /camera/camera/color/camera_info)
        /realsense/points         → point cloud (bridged to /camera/camera/depth/points)
    -->
    <sensor name="realsense_d435" type="rgbd_camera">
        <topic>realsense</topic>
        <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
                <width>424</width>
                <height>240</height>
                <format>R8G8B8</format>
            </image>
            <depth_camera>
                <output>depths</output>
                <clip>
                    <near>0.1</near>
                    <far>5.0</far>
                </clip>
            </depth_camera>
            <clip><near>0.1</near><far>5.0</far></clip>
            <noise>
                <type>gaussian</type>
                <mean>0.0</mean>
                <stddev>0.005</stddev>
            </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <enable_metrics>false</enable_metrics>
    </sensor>
</gazebo>


<!-- ── Logitech C615 ──────────────────────────────────────────────────── -->
<xacro:include filename="camera.xacro" />
<xacro:property name="x" value=".017"/>
<xacro:property name="y" value=".07"/>
<xacro:property name="z" value=".04"/>

<xacro:camera parent="base_link" pos="front" size_x="${x}" size_y="${y}" size_z="${z}">
    <origin xyz=".32792 -.195 .45" rpy="0 0 ${pi_const}"/>
</xacro:camera>

<xacro:camera parent="base_link" pos="back" size_x="${x}" size_y="${y}" size_z="${z}">
    <origin xyz="-.2799208 -.195 .45" rpy="0 0 -${pi_const}"/>
</xacro:camera>


<!-- ── Innomaker ──────────────────────────────────────────────────── -->
<xacro:include filename="camera.xacro" />
<xacro:property name="x" value=".037"/>
<xacro:property name="y" value=".037"/>
<xacro:property name="z" value=".04"/>

<xacro:camera parent="base_link" pos="right" size_x="${x}" size_y="${y}" size_z="${z}">
    <origin xyz="0.00792 -0.195 0.45" rpy="0 0 -1.57"/>
</xacro:camera>

<xacro:camera parent="base_link" pos="left" size_x="${x}" size_y="${y}" size_z="${z}">
    <origin xyz="0.00792 0.195 0.45" rpy="0 0 1.57"/>
</xacro:camera>
</robot>
